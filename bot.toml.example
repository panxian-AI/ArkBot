# ArkBot 配置
# 抗 ban 策略：[[adapters]] 可配多条通道并行 ——
#   onebot11   → NapCat / Lagrange / LLOneBot 等逆向实现（全功能）
#   official_qq → QQ 官方机器人开放平台（不依赖逆向，OneBot 全灭后兜底）
# 事件统一分发、回复走来源通道、一条被 ban 其余无感接管。

[[adapters]]
type = "onebot11"
url = "ws://127.0.0.1:6700"  # NapCat / Lagrange 的正向 WS 地址
access_token = ""             # 实现侧设置的 token，没有就留空
reconnect_interval = 3.0      # 断线初始重连间隔（指数退避，上限 60s）

# 官方通道（可选，封禁兜底）——在 QQ 开放平台创建机器人后填 appid/secret
# [[adapters]]
# type = "official_qq"
# app_id = "102345678"
# app_secret = "your-secret"

[bot]
log_level = "INFO"
plugins_dir = "plugins"
data_dir = "data"              # SQLite（发件箱/openid 映射）落盘目录，自动创建

# ---------------------------------------------------------------------------
# OneBot 11 兼容层 —— 让「以 OneBot 为底层」的软件直接接进来
#   开启后 ArkBot 自己扮演一个 OneBot 实现（与上面的适配器方向相反）：
#     正向 WS   ws://host:port/        NoneBot2 正向、Koishi、自研脚本
#     反向 WS   reverse_urls            AstrBot(aiocqhttp)、NoneBot2 反向
#     HTTP API  POST /send_msg 等        curl / SDK / 面板
#     HTTP 上报 http_report_urls         Serverless、PHP 后台
#   上层一行不改；QQ 侧换通道、走官方兜底、进离线发件箱，它们都感知不到。
#   详见 docs/OneBot兼容层.md
# ---------------------------------------------------------------------------
[compat]
enabled = false
host = "127.0.0.1"             # 给别的机器/容器连就写 0.0.0.0（记得设 token）
port = 6800
access_token = ""              # 建议设置，OneBot 生态通用鉴权
heartbeat_interval = 30        # 心跳间隔（秒），0 = 关闭
# reverse_urls = ["ws://127.0.0.1:6199/ws"]                   # 反向 WS 目标
# http_report_urls = ["http://127.0.0.1:8080/onebot/event"]   # 事件 HTTP 上报
# self_id = 10000              # 不填则用下游通道上报的登录号
# nickname = "ArkBot"

[plugins.groupkit]
auto_friend = true
welcome = "欢迎新同学入群！"
# report_group = 123456789     # 每天 8 点问候的群号（不配则不发）

# ---------------------------------------------------------------------------
# AI 聊天（plugins/ai_chat.py）——把 AstrBot / DSH 养鱼 / 任意模型接进 QQ
# 详见 docs/AI聊天接入.md
# ---------------------------------------------------------------------------
[plugins.ai_chat]
default_backend = "astr"       # 默认用哪个后端（下方 backends 里的键名）
wake_words = ["大鱼", "肥鱼"]   # 群里出现这些词就自动接话
relay = true                   # 群聊「养鱼模式」默认开启（被 @ 也会接话）
cooldown = 5.0                 # 同一会话自动接话最小间隔（秒），/ai 命令不受限
max_chars = 600                # 单条回复最大字数，超出分段发送

# AstrBot：WebUI → 设置 → API Key 建一个带 chat scope 的 key
[plugins.ai_chat.backends.astr]
type = "astrbot"
base_url = "http://127.0.0.1:6185"
api_key = ""                   # abk_xxx
username = "arkbot"            # AstrBot 侧区分会话归属用
stream = true                  # v4.18+ 的 SSE 流式接口

# DSH 养鱼：mode 可选 aurbot / bridge / openai
# [plugins.ai_chat.backends.fish]
# type = "dsh"
# mode = "aurbot"              # aurbot=插件本地接口；bridge=入站队列+outbox；openai=标准协议
# base_url = "http://127.0.0.1:8770"
# path = "/api/chat"
# token = ""

# 最稳的兜底：任意 OpenAI 兼容端点（DeepSeek / Ollama / LM Studio / 网关）
# [plugins.ai_chat.backends.model]
# type = "openai"
# base_url = "https://api.deepseek.com/v1"
# api_key = "sk-..."
# model = "deepseek-chat"
# persona = "你是一条住在 QQ 群里的大肥鱼，说话简短、爱用颜文字。"


# ---------------------------------------------------------------------------
# ArkBot NG（arkbot2 内核）：
#   - 运行 python -m arkbot2 时读取本文件；
#   - [[channels]] 为 NG 新式多通道写法（等效上面的 [[adapters]]）；
#   - 旧插件零改动可用，另支持 entry_points 插件发现。
# ---------------------------------------------------------------------------
# [[channels]]
# type = "onebot11"
# url = "ws://127.0.0.1:6700"
# access_token = ""
#
# [[channels]]
# type = "official_qq"
# app_id = "102345678"
# app_secret = "your-secret"
